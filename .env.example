# Copy to .env and fill in. Never commit the real .env file.

# --- Backend ---
PORT=8080
DATABASE_URL=postgres://yven:yven@localhost:5432/yven?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Auth0 (Authentication)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.yven.org

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=yvenstorage
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=yven-uploads

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Twilio (SMS)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# PostHog (analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
